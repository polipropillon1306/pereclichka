# Telegram Bot Token (от @BotFather)
BOT_TOKEN=1234567890:ABCdefGhIJKlmNoPQRsTUVwxyZ

# Google Sheets интеграция
GOOGLE_SHEET_URL=
GOOGLE_SERVICE_ACCOUNT_FILE=service_account.json

# Время запуска опроса и проверки прихода (МСК)
POLL_TIME=20:00
CHECK_TIME=11:00

# Telegram ID администраторов через запятую
ADMIN_IDS=123456789,987654321

# Telegram ID главного администратора (доступ к аудиту и алертам в ЛС)
SUPERADMIN_ID=7779352589

# Разрешенные ID групп/чатов через запятую
ALLOWED_CHAT_IDS=-1001234567890

# Настройки безопасности и лимитов переклички
MAX_VOTE_CHANGES=3
RATE_LIMIT_CALLBACK=2.0
RATE_LIMIT_MESSAGE=1.0
SHEETS_SYNC_DEBOUNCE_SECONDS=5.0

